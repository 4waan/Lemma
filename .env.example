# Shared service configuration
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://lemma:lemma_local_only@localhost:5432/lemma
# Required in production: at least 32 random characters, the same on every replica and restart (keys client addresses in demand counts)
DEMAND_SOURCE_KEY=

# Arbitrum Sepolia
# Server: required with PAID_TOOLS=on and by the ERC-8004 attester, and a secret (providers put their key in the URL). The bridge needs no RPC.
ARBITRUM_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_CHAIN_ID=421614
USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# Warranty pipeline (server): on only with this, PROVIDER_PRIVATE_KEY, EVALUATOR_PRIVATE_KEY, PAID_TOOLS=on, the RPC URL and DATABASE_URL
RESOLUTION_WARRANTY_REGISTRY_ADDRESS=
# The registry's deployment block: the indexer reads its events from there (default 0)
WARRANTY_REGISTRY_START_BLOCK=
# review (default: an operator decides each failed outcome, npm run evaluator -w @lemma/server) or auto
EVALUATOR_FAILURES=
# Up to this many seconds of random delay before each warranty activation (default 300; 0 for local runs)
WARRANTY_ACTIVATION_JITTER_SECONDS=
# How many blocks behind the latest one the indexer stops reading the registry (default 64; 0 only on a local chain)
WARRANTY_INDEXER_CONFIRMATIONS=
# Dashboard explorer links (default https://sepolia.arbiscan.io). Unlike the other settings, empty is not unset: EXPLORER_BASE_URL= turns them off
# EXPLORER_BASE_URL=https://sepolia.arbiscan.io

# ERC-8004 reputation (server; all optional, off unless the attester key, RPC URL, agent id, an https PUBLIC_BASE_URL and DATABASE_URL are set)
# Registries default to the Arbitrum Sepolia deployments; set only to override.
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=
# The widest eth_getLogs block range the attester asks for (default 10000); lower it if the RPC provider allows less
ERC8004_LOG_RANGE=
# The provider's agent id, printed by `npm run agent:register -w @lemma/server`
LEMMA_AGENT_ID=
# Signs every giveFeedback and needs testnet ETH for gas; must differ from AGENT_OWNER_PRIVATE_KEY
ATTESTER_PRIVATE_KEY=
# Register script only (owns the provider agent); keep it off the server
AGENT_OWNER_PRIVATE_KEY=

# Server behavior (defaults shown; see docs/deployment.md)
PAID_TOOLS=off
ALLOW_PROVISIONAL_EVIDENCE=false
OFFER_TTL_SECONDS=900
PAYMENT_TIMEOUT_SECONDS=300
DASHBOARD_ORIGIN=
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=60

# Server-only role addresses and keys
PROVIDER_ADDRESS=
# Warranty pipeline: signs vouchers, sends activations and expiries (needs Sepolia ETH); differs from every other role key. A secret.
PROVIDER_PRIVATE_KEY=
FACILITATOR_ADDRESS=
# Required with PAID_TOOLS=on (with ARBITRUM_SEPOLIA_RPC_URL): pays settlement gas; fund with Sepolia ETH. A secret.
FACILITATOR_PRIVATE_KEY=
EVALUATOR_ADDRESS=
# Warranty pipeline: signs outcomes, sends finalizations and relays credit withdrawals (needs Sepolia ETH); differs from every other role key. A secret.
EVALUATOR_PRIVATE_KEY=
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
# Warranty registry administrator (contracts/README.md, "Deploy")
REGISTRY_OWNER_ADDRESS=
# Operator scripts only, on the operator's machine, never the server (docs/deployment.md, runbook). Give each key to its
# one command from its role key file, e.g. REGISTRY_OWNER_PRIVATE_KEY="$(cat "$ROLES/deployer.key")"; never keep it in .env.
# npm run warranty:admin -w @lemma/server: register-release and set-engine as the registry's owner, set-priors as the
# engine's owner (deposit-bond uses PROVIDER_PRIVATE_KEY; register-release reads PROVIDER_ADDRESS and EVALUATOR_ADDRESS)
REGISTRY_OWNER_PRIVATE_KEY=
ENGINE_OWNER_PRIVATE_KEY=
# npm run sepolia:roles: funds the role keys it makes with testnet ETH and USDC
ARBITRUM_SEPOLIA_FUNDER_PRIVATE_KEY=

# Local MCP bridge only. The buyer key is never here: it lives in lemma-signer's key file.
LEMMA_API_URL=http://localhost:3000
# The lemma-signer socket (default <state>/signer/signer.sock, where lemma-signer serve listens).
# Purchases stay off until a signer answers there and the three policy values below are set.
LEMMA_SIGNER_SOCKET=
# Spending policy, read by the bridge and by lemma-signer, in atomic USDC (250000 is 0.25 USDC, 1000000 is 1 USDC)
LEMMA_MAX_USDC_PER_RESOLUTION=
LEMMA_DAILY_USDC_CAP=
# Comma-separated recipient addresses the buyer will pay (the server's PROVIDER_ADDRESS)
LEMMA_ALLOWED_PAY_TO=
# Optional: where warranty credits are paid (default: the buyer's address, which a withdrawal shows on chain)
LEMMA_REFUND_TO=
# The bridge's LEMMA_AGENT_ID is the buyer agent's own ERC-8004 id (opt-in), not the server's provider id above:
# set it in the bridge's MCP configuration, never in the server's environment.

# lemma-signer only (never in the bridge's environment)
LEMMA_SIGNER_KEY_FILE=
# 600 (the default, also when empty), or 660 for a signer run as another user sharing a group with the bridge
LEMMA_SIGNER_SOCKET_MODE=

# Benchmark only
CURSOR_API_KEY=
LEMMA_BENCHMARK_MODEL=

# Local Postgres container only
POSTGRES_USER=lemma
POSTGRES_PASSWORD=lemma_local_only
POSTGRES_DB=lemma
