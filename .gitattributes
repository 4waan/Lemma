# Catalog payloads are hashed byte for byte (bundleDigest, baseDigest). Never
# convert their line endings on checkout, or digests would depend on the
# machine that checked them out.
packages/catalog/releases/** -text
packages/catalog/releases.provisional/** -text
packages/catalog/fixtures/** -text
packages/benchmark/fixtures/** -text
# The committed engine module is compared byte for byte with a clean rebuild
# (npm run confidence:wasm:check).
packages/confidence/wasm/*.wasm binary
