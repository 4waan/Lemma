  },
  "dependencies": {
    "@lemma/core": "0.1.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/mcp": "2.27.0",
    "viem": "2.56.8",
    "zod": "4.6.5"
