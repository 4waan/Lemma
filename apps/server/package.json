{
  "name": "@lemma/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --root ../.. apps/server/test",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@lemma/catalog": "0.1.0",
    "@lemma/core": "0.1.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/mcp": "2.27.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "postgres": "3.4.9",
    "viem": "2.56.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "drizzle-kit": "0.31.11"
  }
}
