{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "paths": {
      "@lemma/core": ["./packages/core/src/index.ts"],
      "@lemma/catalog": ["./packages/catalog/src/index.ts"],
      "@lemma/benchmark": ["./packages/benchmark/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "apps/server/src",
    "apps/server/test",
    "apps/bridge/src",
    "apps/bridge/test",
    "vitest.config.ts"
  ]
}
